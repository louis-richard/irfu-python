   "source": [
    "## Load spacecraft positions "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "[07-Feb-26 01:14:08] INFO: Loading mms1_mec_r_gse...\n",
      "[07-Feb-26 01:14:08] INFO: Loading mms2_mec_r_gse...\n",
      "[07-Feb-26 01:14:08] INFO: Loading mms3_mec_r_gse...\n",
      "[07-Feb-26 01:14:08] INFO: Loading mms4_mec_r_gse...\n"
     ]
    }
   ],
   "source": [
    "tint_long = pyrf.extend_tint(tint, [-60, 60])\n",
    "r_xyz_mms = [mms.get_data(\"r_gse_mec_srvy_l2\", tint_long, ic) for ic in range(1, 5)]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Convert SCM magnetic field to field-aligned coordinates"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "b_fac_mms = [\n",
    "    pyrf.convert_fac(b_scm, b_xyz, [1, 0, 0])\n",
    "    for b_scm, b_xyz in zip(b_scm_mms, b_xyz_mms)\n",
    "]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Compute 4 s/c dispersion relation"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Define time interval of wave burst"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "tints = [\"2015-10-16T13:05:26.500\", \"2015-10-16T13:05:27.000\"]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Get a perpandicular component of the fluctuating magnetic field"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "b_para_mms = [b_fac[:, 0] for b_fac in b_fac_mms]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Calculate 4 s/c dispersion relation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "[07-Feb-26 01:14:25] WARNING: /homelocal/louisr/irfu-python/.venv/lib/python3.12/site-packages/pyrfu/mms/fk_power_spectrum_4sc.py:168: ComplexWarning: Casting complex values to real discards the imaginary part\n",
      "  fk_power += (w[i].data * np.conj(w[i].data) / 4).astype(np.float64)\n",
      "\n",
      "[07-Feb-26 01:16:08] INFO: Computing power versus (kx,f); (ky,f), (kz,f), (k,f)\n",
      "[07-Feb-26 01:16:10] INFO: Computing power versus (kx,ky); (kx,kz); (ky,kz)\n",
      "[07-Feb-26 01:16:11] INFO: Computing power versus kperp,kpara\n"
     ]
    }
   ],
   "source": [
    "power = mms.fk_power_spectrum_4sc(\n",
    "    b_para_mms, r_xyz_mms, b_xyz_mms, tints, df=10.0, num_k=500, cav=4, w_width=2.0\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Change units of wavevector and frequency (for plotting)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "power = power.assign_coords(\n",
    "    k_x=power.k_x.data * 1e4, k_y=power.k_y.data * 1e4, k_z=power.k_z.data * 1e4\n",
    ")\n",
    "power = power.assign_coords(\n",
    "    k_perp=power.k_perp.data * 1e4, k_par=power.k_par.data * 1e4\n",
    ")\n",
    "power = power.assign_coords(k_mag=power.k_mag.data * 1e4)\n",
    "power = power.assign_coords(f=power.f.data * 1e-3)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
