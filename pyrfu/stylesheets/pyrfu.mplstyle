## *************************************************************************************
## * pyrfu style: the look of the pyrfu example notebooks                              *
## * Used by pyrfu.plot.use_pyrfu_style(), or plt.style.use("pyrfu") once pyrfu.plot   *
## * is imported. Applied on top of matplotlib's default style.                        *
## author : Louis Richard
## email : louis.richard@physics.ox.ac.uk
## *************************************************************************************

## Colours: the pyrfu colour cycle (blue, green, red, dark grey, ...) and a
## diverging colormap for spectrograms
axes.prop_cycle: cycler("color", ["005f87", "008700", "af0000", "444444", "d75f00", "8700af", "afaf00", "0087af", "5f7800"])
image.cmap: Spectral_r

## Ticks
xtick.minor.visible: True
ytick.minor.visible: True

## Text: mathtext in DejaVu Sans, no LaTeX
text.usetex: False
mathtext.fontset: dejavusans
mathtext.sf: sans

## Legend: frameless, in the upper right corner
legend.loc: upper right
legend.frameon: False
legend.fancybox: False
legend.framealpha: 0.75
legend.handlelength: 1.5
